    "ds_jaccard": "1-|F_>k(x_k,a) intersect F_>k(x_k,b)|/|F_>k(x_k,a) union F_>k(x_k,b)|",
    "old_structural_risk": "r_old(x_k,a)=sum_b pi_old_bar(b|x_k)*c_DS(x_k;a,b)",
    "policy_distance": "D_DS=E_x[0.5*sum_a |pi_new_bar(a|x)-pi_old_bar(a|x)|*r_old(x,a)]"
  },
